{
  "name": "screens",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run lint && vite build",
    "serve": "vite preview",
    "lint": "eslint ./src --ext .js,.vue && stylelint './src/**/*.{css,scss,sass}'",
    "lint:fix": "eslint ./src --ext .js,.vue --fix && stylelint './src/**/*.{css,scss,sass}' --fix"
  },
  "dependencies": {
    "@vueform/slider": "^2.1.10",
    "d3": "^7.9.0",
    "entreacte": "^1.0.1",
    "js-yaml": "^4.1.0",
    "leaflet": "^1.9.4",
    "painless-airtable": "^0.3.0",
    "qrcode.vue": "^3.6.0",
    "remarkable": "^2.0.1",
    "remixicon": "^2.5.0",
    "reset-css": "^5.0.2",
    "units-converter": "^1.0.3",
    "vue": "^3.5.22",
    "vue-i18n": "^9.14.5",
    "vue-inline-svg": "^3.1.4",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@rollup/plugin-yaml": "^3.1.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "autoprefixer": "^10.4.8",
    "eslint": "^8.57.1",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-plugin-vue": "^9.33.0",
    "sass": "^1.93.2",
    "stylelint": "^14.16.1",
    "stylelint-config-standard": "^28.0.0",
